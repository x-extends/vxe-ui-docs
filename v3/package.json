{
  "name": "vxe-ui-v3",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "update": "npm install --legacy-peer-deps",
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build --no-module --no-clean",
    "build:offline": "vue-cli-service build --no-module --no-clean --mode offline",
    "lint": "vue-cli-service lint",
    "lint:es": "eslint src --ext .js,.ts,.jsx,.tsx,.vue",
    "lint:ox": "oxfmt --check src/**",
    "esfix": "eslint --fix src --ext .js,.ts,.jsx,.tsx,.vue",
    "oxfix": "oxfmt src/** --write",
    "pack": "node scripts/build-clean.js && concurrently --timings \"npm run build\" \"node scripts/build-example.js\" && npm run oxfix:examples",
    "pack:offline": "node scripts/build-clean.js && concurrently --timings \"npm run build:offline\" \"node scripts/build-example.js\" && npm run oxfix:examples",
    "esfix:examples": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx,.vue dist/example/js/**",
    "oxfix:examples": "oxfmt dist/example/js/ --write",
    "clean:all": "node scripts/clean-all"
  },
  "dependencies": {
    "axios": "~1.20.0",
    "core-js": "^3.49.0",
    "vue": "2.6.14",
    "vue-i18n": "~8.15.1",
    "vue-router": "~3.5.1",
    "vuex": "~3.6.2",
    "vxe-design": "~3.0.3",
    "vxe-gantt": "3.10.0-beta.1",
    "vxe-pc-ui": "~3.21.0",
    "vxe-table": "3.26.0-beta.3",
    "xe-utils": "^4.2.3"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "@typescript-eslint/eslint-plugin": "~6.21.0",
    "@typescript-eslint/parser": "~6.21.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-standard": "~6.1.0",
    "@vue/eslint-config-typescript": "~9.1.0",
    "concurrently": "^10.0.6",
    "del": "~6.0.0",
    "eslint": "~7.32.0",
    "eslint-plugin-import": "~2.29.1",
    "eslint-plugin-node": "~11.1.0",
    "eslint-plugin-promise": "~6.1.1",
    "eslint-plugin-vue": "~8.0.3",
    "oxfmt": "~0.51.0",
    "sass": "~1.106.0",
    "sass-loader": "~14.2.1",
    "typescript": "~5.9.3",
    "vue-template-compiler": "2.6.14"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true,
    "es5-ext": true,
    "yorkie": true
  }
}